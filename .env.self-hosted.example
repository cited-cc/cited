# Self-hosted open-source example
# Copy to .env.local for local development.

NEXT_PUBLIC_APP_URL=http://localhost:3000
CITED_DEPLOYMENT_MODE=self_hosted
NEXT_PUBLIC_CITED_DEPLOYMENT_MODE=self_hosted

# Database (Phase 7)
CITED_DATABASE_PROVIDER=postgres
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/cited
# DATABASE_MIGRATION_URL=postgresql://postgres:postgres@127.0.0.1:5432/cited
# DATABASE_POOL_MAX=10
# DATABASE_IDLE_TIMEOUT_SECONDS=30
# DATABASE_CONNECT_TIMEOUT_SECONDS=10
# DATABASE_SSL_MODE=prefer

# Authentication (Phase 5)
CITED_AUTH_PROVIDER=local
NEXT_PUBLIC_CITED_AUTH_PROVIDER=local
AUTH_SECRET=replace-with-at-least-32-random-characters
CITED_BOOTSTRAP_TOKEN=replace-with-a-long-random-bootstrap-token
CITED_ALLOW_REGISTRATION=false
# CITED_SESSION_MAX_AGE_SECONDS=604800

# Optional local Supabase tooling (not required for self-hosted PostgreSQL)
# CITED_DATABASE_PROVIDER=supabase
# SUPABASE_URL=http://127.0.0.1:54321
# SUPABASE_ANON_KEY=replace_me
# SUPABASE_SERVICE_ROLE_KEY=replace_me

# Core monitoring (bring-your-own DataForSEO credentials)
CITED_MONITORING_PROVIDER=mock
MONITORING_PROVIDER=mock
CITED_ALLOW_MOCK_PROVIDER=true
MONITORING_ENABLED=false
MONITORING_CRON_SECRET=replace_me
DATAFORSEO_LOGIN=replace_me
DATAFORSEO_PASSWORD=replace_me

# Optional workspace notifications via SMTP or Slack
NOTIFICATIONS_ENABLED=false
CITED_EMAIL_PROVIDER=disabled
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_SECURE=false
SLACK_WEBHOOK_ENCRYPTION_KEY=

# Optional self-hosted operational safety limits (Phase 6)
# Use a positive integer or "unlimited"
# CITED_SELF_HOSTED_MAX_USERS=unlimited
# CITED_SELF_HOSTED_MAX_DOMAINS=unlimited
# CITED_SELF_HOSTED_MAX_MONITORS=unlimited
# CITED_SELF_HOSTED_MAX_PROMPTS=unlimited
# CITED_SELF_HOSTED_HISTORY_DAYS=unlimited

# Cloud-only variables are intentionally omitted:
# Clerk, Stripe billing, hosted analytics, marketing free-scan, chatbot, Learn Domains handoff

# Support contacts for local/dev
NEXT_PUBLIC_SUPPORT_EMAIL=hello@example.com
SECURITY_CONTACT_EMAIL=security@example.com
