# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
*.p12

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*
!.env.example
!.env.cloud.example
!.env.self-hosted.example
!.env.docker.example

# self-hosted local state
.cited/

# local supabase state
supabase/.branches
supabase/.temp

# publication safety artifacts
publication-scan-report.*
.publication-manifest.*

# credential exports
*credentials*.json
*.credentials

# database dumps
*.sql.dump
*.dump.sql
*.pgdump

# outreach exports
*outreach*export*

# history rewrite artifacts
.git-rewrite-backup/
filter-repo/

# private backup bundles
*.bundle
cited-private-backup-*

# generated secret scan reports
secret-scan-report.*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# editor-local
.cursor/
.agents/
.mcp.json

# OS
Thumbs.db
