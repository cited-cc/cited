# Self-hosted Docker configuration (non-secret)
# Copy to .cited/config.env or merge into your shell environment.
# Secrets live only in .cited/secrets/ and are generated by npm run self-host:init.

# Web port published on localhost
CITED_WEB_PORT=3000

# Canonical browser URL for this installation
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Deployment and auth
CITED_DEPLOYMENT_MODE=self_hosted
CITED_AUTH_PROVIDER=local

# Database (passwords are secret files, not values here)
DATABASE_NAME=cited

# Monitoring defaults (mock provider, no external calls)
CITED_MONITORING_PROVIDER=mock
CITED_ALLOW_MOCK_PROVIDER=true
MONITORING_ENABLED=true

# Notifications default to disabled/null delivery
NOTIFICATIONS_ENABLED=false
CITED_EMAIL_PROVIDER=disabled

# Worker timing
CITED_JOBS_WORKER_TICK_MS=30000

# Image selection (local build by default)
# CITED_IMAGE=cited-local:latest

# Optional Mailpit profile for local SMTP testing:
# docker compose --profile mailpit up -d
# SMTP_HOST=mailpit
# SMTP_PORT=1025
# CITED_EMAIL_PROVIDER=smtp
# NOTIFICATIONS_ENABLED=true

# Support contacts (non-secret placeholders)
NEXT_PUBLIC_SUPPORT_EMAIL=hello@example.com
SECURITY_CONTACT_EMAIL=security@example.com

# Time zone policy for containers (UTC inside; set host TZ separately if needed)
TZ=UTC

# Operational limits (optional)
# CITED_SELF_HOSTED_MAX_USERS=unlimited
# CITED_SELF_HOSTED_MAX_DOMAINS=unlimited

# Secret files (generated by self-host:init, do not commit):
# .cited/secrets/postgres_owner_password
# .cited/secrets/postgres_runtime_password
# .cited/secrets/auth_secret
# .cited/secrets/bootstrap_token
# .cited/secrets/monitoring_cron_secret
# .cited/secrets/slack_webhook_encryption_key
