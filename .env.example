# Cited community edition environment example
# Copy to .env.local for local development, or use .env.self-hosted.example for Docker.

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Deployment mode (community edition accepts self_hosted only)
CITED_DEPLOYMENT_MODE=self_hosted
NEXT_PUBLIC_CITED_DEPLOYMENT_MODE=self_hosted

# Database
CITED_DATABASE_PROVIDER=postgres
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/cited
# DATABASE_MIGRATION_URL=postgresql://postgres:postgres@127.0.0.1:5432/cited
# DATABASE_POOL_MAX=10
# DATABASE_IDLE_TIMEOUT_SECONDS=30
# DATABASE_CONNECT_TIMEOUT_SECONDS=10
# DATABASE_SSL_MODE=prefer

# Authentication (local auth is the community default)
CITED_AUTH_PROVIDER=local
NEXT_PUBLIC_CITED_AUTH_PROVIDER=local
AUTH_SECRET=
CITED_BOOTSTRAP_TOKEN=
CITED_ALLOW_REGISTRATION=false
# CITED_SESSION_MAX_AGE_SECONDS=604800

# Optional Supabase tooling (not required for self-hosted PostgreSQL)
# SUPABASE_URL=http://127.0.0.1:54321
# SUPABASE_ANON_KEY=replace_me
# SUPABASE_SERVICE_ROLE_KEY=replace_me

# Monitoring (bring-your-own DataForSEO credentials, or mock for local dev)
CITED_MONITORING_PROVIDER=mock
MONITORING_PROVIDER=mock
CITED_ALLOW_MOCK_PROVIDER=true
MONITORING_ALLOW_MOCK_PROVIDER=true
MONITORING_ENABLED=false
MONITORING_CRON_SECRET=
CRON_SECRET=
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
DATAFORSEO_API_BASE_URL=https://api.dataforseo.com
MONITORING_DISPATCH_BATCH_SIZE=25
MONITORING_PROCESS_BATCH_SIZE=20
MONITORING_MAX_ATTEMPTS=4
MONITORING_ENABLED_SURFACES=chatgpt,gemini,perplexity,claude,google_ai_overviews,google_ai_mode

# Notifications (SMTP, Slack, or disabled)
NOTIFICATIONS_ENABLED=false
CITED_EMAIL_PROVIDER=disabled
NOTIFICATIONS_CRON_SECRET=
NOTIFICATIONS_DISPATCH_BATCH_SIZE=25
NOTIFICATIONS_MAX_ATTEMPTS=5
NOTIFICATIONS_STALE_LOCK_MINUTES=15
NOTIFICATIONS_BASE_URL=
NOTIFICATION_UNSUBSCRIBE_TOKEN_TTL_DAYS=90
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_SECURE=false
SLACK_WEBHOOK_ENCRYPTION_KEY=

# Portable background jobs
CITED_JOBS_WORKER_TICK_MS=30000

# Optional self-hosted operational safety limits
# Use a positive integer or "unlimited"
# CITED_SELF_HOSTED_MAX_USERS=unlimited
# CITED_SELF_HOSTED_MAX_DOMAINS=unlimited
# CITED_SELF_HOSTED_MAX_MONITORS=unlimited
# CITED_SELF_HOSTED_MAX_PROMPTS=unlimited
# CITED_SELF_HOSTED_HISTORY_DAYS=unlimited

# Support contacts (use your own addresses in production)
NEXT_PUBLIC_SUPPORT_EMAIL=hello@example.com
SECURITY_CONTACT_EMAIL=security@example.com
PRIVACY_CONTACT_EMAIL=privacy@example.com

# Managed hosting is available at https://cited.cc for users who prefer not to self-host.
