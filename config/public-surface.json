{
  "schemaVersion": "1",
  "distributionName": "cited-open-source",
  "supportedDeploymentMode": "self_hosted",
  "publicApplicationAreas": [
    "app/(marketing)/",
    "app/(auth)/",
    "app/app/",
    "app/onboarding/",
    "app/api/auth/",
    "app/api/export/",
    "app/api/health/",
    "app/api/contact/",
    "app/api/unsubscribe/",
    "app/api/internal/monitoring/",
    "app/api/internal/notifications/",
    "components/",
    "lib/auth/",
    "lib/database/",
    "lib/deployment/",
    "lib/entitlements/",
    "lib/monitoring/",
    "lib/providers/",
    "lib/citations/",
    "lib/evidence/",
    "lib/inbox/",
    "lib/notebook/",
    "lib/export/",
    "lib/notifications/",
    "lib/jobs/",
    "docs/",
    "docker/",
    "scripts/",
    "supabase/migrations/",
    "public/"
  ],
  "publicProviderAdapters": [
    "dataforseo",
    "mock"
  ],
  "publicNotificationAdapters": [
    "smtp",
    "slack",
    "disabled"
  ],
  "publicCommands": [
    "dev",
    "build",
    "start",
    "lint",
    "typecheck",
    "test",
    "public-surface:check",
    "publication:check",
    "deployment:check",
    "auth:check",
    "database:check",
    "provider:check",
    "monitoring:check",
    "scheduler:check",
    "notifications:check",
    "docker:check",
    "license:check",
    "security:scan",
    "content:check",
    "seo:check",
    "db:migrate",
    "db:seed",
    "self-host:init",
    "self-host:up",
    "self-host:smoke"
  ],
  "publicRoutes": [
    "/",
    "/pricing",
    "/demo",
    "/docs",
    "/blog",
    "/sign-in",
    "/sign-up",
    "/setup",
    "/accept-invite",
    "/app",
    "/app/monitors",
    "/app/inbox",
    "/app/notebook",
    "/app/settings",
    "/api/health",
    "/api/export",
    "/api/internal/monitoring/dispatch",
    "/api/internal/notifications/dispatch",
    "/api/internal/notifications/digests"
  ],
  "forbiddenCloudCategories": [
    "clerk-authentication",
    "stripe-billing",
    "resend-hosted-email",
    "marketing-free-scan",
    "marketing-chatbot",
    "hosted-analytics",
    "lifecycle-campaigns",
    "learn-domains-handoff",
    "product-hunt-launch",
    "cloud-cron-jobs"
  ],
  "forbiddenDependencies": [
    "@clerk/nextjs",
    "@clerk/backend",
    "stripe",
    "resend",
    "svix",
    "ai",
    "@ai-sdk/anthropic",
    "@ai-sdk/gateway",
    "@vercel/analytics",
    "@datafast/ai-crawl",
    "@datafast/cli"
  ],
  "forbiddenEnvPrefixes": [
    "CLERK_",
    "NEXT_PUBLIC_CLERK_",
    "STRIPE_",
    "BILLING_",
    "RESEND_",
    "INBOUND_MAIL_",
    "FREE_SCAN_",
    "NEXT_PUBLIC_FREE_SCAN_",
    "NEXT_PUBLIC_CITED_CHATBOT_",
    "DATAFAST_",
    "LEARN_DOMAINS_",
    "NEXT_PUBLIC_LAUNCH_",
    "NEXT_PUBLIC_PRODUCT_HUNT_"
  ],
  "forbiddenRoutes": [
    "app/api/webhooks/clerk",
    "app/api/webhooks/stripe",
    "app/api/webhooks/resend",
    "app/api/billing",
    "app/api/scan",
    "app/api/chatbot",
    "app/api/internal/billing",
    "app/api/internal/scan",
    "app/api/internal/notifications/lifecycle",
    "app/api/internal/resend",
    "app/api/integrations/learn-domains",
    "app/checkout",
    "app/app/billing",
    "app/(marketing)/scan",
    "app/(marketing)/launch"
  ],
  "forbiddenDirectories": [
    "lib/billing",
    "lib/chatbot",
    "lib/scan",
    "lib/launch",
    "lib/integrations",
    "components/billing",
    "components/chatbot",
    "components/launch",
    "launch",
    "research"
  ],
  "requiredDocumentation": [
    "README.md",
    "docs/open-source/self-hosting.md",
    "docs/open-source/docker.md",
    "docs/open-source/authentication.md",
    "docs/open-source/deployment-modes.md",
    "docs/open-source/distribution-boundary.md",
    "docs/open-source/publication-boundary.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "requiredAssets": [
    "public/cited-mark.svg"
  ],
  "managedHostingLink": {
    "url": "https://cited.cc",
    "label": "Prefer a managed deployment? Visit cited.cc."
  }
}
